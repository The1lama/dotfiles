            "today": "<span color='#665c59'><u>{}</u></span>",
            "weekdays": "<span color='#ebdbb2'><b>{}</b></span>",
            "weeks": "<span color='#a6e3a1'><b>w{}</b></span>"
          }
        }
    },
    "wireplumber": {
        "scroll-step": 5, // %, can be a float
        "format": "{icon}  {volume}%",
        "format-muted": " ",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    }

}]
